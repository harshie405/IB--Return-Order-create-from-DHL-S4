      IMPORTING
        out_vbak    = vbak
        out_vbap    = vbap
        out_vbkd    = vbkd
        out_vbep    = vbep
        out_vbuk    = vbuk
        out_vbup    = vbup
        out_yvbak   = yvbak
        out_xvbap   = xvbap
      TABLES
        t_vbap      = xvbap
        t_xvbfa     = xvbfa[]
        t_xvbkd     = xvbkd[]
        t_xvbep     = xvbep[]
        t_xvbuk     = xvbuk[]
        t_xvbup     = xvbup[]
        t_xvbpa     = xvbpa[]
        t_yvbap     = yvbap[]
        t_yvbfa     = yvbfa[]
        t_yvbkd     = yvbkd[]
        t_yvbep     = yvbep[]
        t_yvbuk     = yvbuk[]
        t_yvbup     = yvbup[]
        idoc_status = idoc_status.

  ENDLOOP.
ENDIF.

FUNCTION zcomv_ret_ord_dhl_to_s4.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(DXVBAK) OPTIONAL
*"     VALUE(DVTCOMAG) OPTIONAL
*"     VALUE(DLAST_DYNPRO) OPTIONAL
*"     VALUE(DXMESCOD) LIKE  EDIDC-MESCOD OPTIONAL
*"  TABLES
*"      DXBDCDATA STRUCTURE  BDCDATA OPTIONAL
*"      DXVBAP OPTIONAL
*"      DXVBEP OPTIONAL
*"      DYVBEP OPTIONAL
*"      DXVBADR OPTIONAL
*"      DYVBADR OPTIONAL
*"      DXVBPA STRUCTURE  VBPAVB OPTIONAL
*"      DXVBUV OPTIONAL
*"      DIDOC_DATA STRUCTURE  EDIDD OPTIONAL
*"      DXKOMV OPTIONAL
*"      DXVEKP OPTIONAL
*"      DYVEKP OPTIONAL
*"----------------------------------------------------------------------
*----------------------------------------------------------------------*
* Development ID  : ZDDE-00086243                                      *
* Functional Spec : ZFSE-00086242                                      *
* Description     : Return Order create from DHL>S4                    *
* This Function module is triggered Via Customer Exit                  *
* Customer exit   : EXIT_SAPLVEDA_002                                  *
* Include         : ZEXIT_VEDU04_02, ZXVEDU04                          *
*----------------------------------------------------------------------*
*  Change Log:                                                         *
* ---------------------------------------------------------------------*
*    Who       Date           CR            Text                       *
*  AMIREHA1   18-09-2024    1100249576   Initial Development           *
* ---------------------------------------------------------------------*

* Local Constants Declaration
  CONSTANTS:lc_fnam_reas   TYPE bdcdata-fnam VALUE 'VBAP-MSR_RET_REASON',
            lc_fnam_code   TYPE bdcdata-fnam VALUE 'VBAP-MSR_REFUND_CODE',
            lc_fnam_quan   TYPE bdcdata-fnam VALUE 'RV45A-KWMENG',
            lc_fnam_charg  TYPE bdcdata-fnam VALUE 'VBAP-CHARG(1)',
            lc_bracket     TYPE char1        VALUE ')',
            lc_fnam_kuagv  TYPE bdcdata-fnam VALUE 'KUAGV-KUNNR',
            lc_fnam_uom    TYPE bdcdata-fnam VALUE 'VBAP-VRKME',
            lc_fnam_lgort  TYPE bdcdata-fnam VALUE 'VBAP-LGORT',
            lc_fnam_bstkd  TYPE bdcdata-fnam VALUE 'VBKD-BSTKD',
            lc_fnam_werks  TYPE bdcdata-fnam VALUE 'VBAP-WERKS',
            lc_selection   TYPE bdcdata-fnam VALUE 'RV45A-VBAP_SELKZ(',
            lc_fval_ret    TYPE bdcdata-fval VALUE 'T\03',
            lc_fval_next   TYPE bdcdata-fval VALUE 'ITPP',
            lc_fval_first  TYPE bdcdata-fval VALUE 'ITP1',
            lc_fval_uer2   TYPE bdcdata-fval VALUE 'UER2',
            lc_fval_rueb   TYPE bdcdata-fval VALUE 'RUEB',
            lc_fval_poan   TYPE bdcdata-fval VALUE 'POAN',
            lc_fval_sich   TYPE bdcdata-fval VALUE 'SICH',
            lc_fval_rfak   TYPE bdcdata-fval VALUE 'RFAK',
            lc_fval_copy   TYPE bdcdata-fval VALUE 'COPY',
            lc_fval_pkau   TYPE bdcdata-fval VALUE 'PKAU',
            lc_fval_pde2   TYPE bdcdata-fval VALUE 'PDE2',
            lc_fnam_ok     TYPE bdcdata-fnam VALUE 'BDC_OKCODE',
            lc_fnam_vbeln  TYPE bdcdata-fnam VALUE 'VBRK-VBELN',
            lc_fnam_spart  TYPE bdcdata-fnam VALUE 'VBAK-SPART',
            lc_fnam_matnr  TYPE bdcdata-fnam VALUE 'VBAP-MATNR(',
            lc_fnam_ctrl   TYPE bdcdata-fnam VALUE 'GS_MSR_SALES_ITEM-REFUND_CONTROL',
            lc_fnam_fucode TYPE bdcdata-fnam VALUE 'GS_MSR_SALES_ITEM-FU_CODE',
            lc_fnam_abgru  TYPE bdcdata-fnam VALUE 'GS_MSR_SALES_ITEM-CMR_ABGRU',
            lc_zarm_seg    TYPE edilsegtyp   VALUE 'ZCOMV_ARM',
            lc_item_seg    TYPE edilsegtyp   VALUE 'E1EDP01',
            lc_progname    TYPE bdcdata-program VALUE 'SAPMV45A',
            lc_dynpronr    TYPE bdcdata-dynpro  VALUE '4001',
            lc_dynpronr1   TYPE bdcdata-dynpro  VALUE '4003',
            lc_i           TYPE char1      VALUE 'I',
            lc_eq          TYPE char2      VALUE 'EQ'.

* Local Data Declaration
  DATA:ls_arm           TYPE zcomv_arm,
       ls_idoc_item     TYPE e1edp01,
       lv_index         TYPE sy-tabix,
       lv_count         TYPE i,
       lv_processed     TYPE char1,
       ls_bdc_sich      TYPE bdcdata,
       ls_bdc_poan      TYPE bdcdata,
       lv_ihrez         TYPE vgbel,
       lt_vbap          TYPE STANDARD TABLE OF vbapvb,
       ls_e1edp01_lgort TYPE e1edp01,
       ls_e1edk02       TYPE e1edk02,
       ls_val           TYPE bdcdata,
       lr_charg         TYPE RANGE OF bdcdata-fval,
       lv_tabix         TYPE char3.


  FIELD-SYMBOLS : <lfs_dxvbap> TYPE any.

  ls_val = 'X'.

  ASSIGN dxvbap[] TO <lfs_dxvbap>.
* Check for reference document number(Invoice)
  IF <lfs_dxvbap> IS ASSIGNED.
    lt_vbap = CORRESPONDING #( <lfs_dxvbap> ).
    IF line_exists( lt_vbap[ vgbel = wc_space ] ).
      lv_processed = abap_true.
    ENDIF.
  ENDIF.

  LOOP AT lt_vbap ASSIGNING FIELD-SYMBOL(<lfs_vbap>).
    lr_charg = VALUE #( BASE lr_charg ( sign = lc_i
                                         option = lc_eq
                                         low = <lfs_vbap>-charg ) ).
  ENDLOOP.

  IF line_exists( dxbdcdata[ fnam = lc_fnam_kuagv ] ).
    IF NOT line_exists( dxbdcdata[ fnam = lc_fnam_bstkd ] ).
      ASSIGN didoc_data[ segnam = 'E1EDK02' ] TO FIELD-SYMBOL(<lfs_eledk02>).
      IF <lfs_eledk02> IS ASSIGNED.
        ls_e1edk02 = <lfs_eledk02>-sdata.
      ENDIF.
      PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_bstkd ls_e1edk02-belnr.
    ENDIF.
  ENDIF.
* Proceed if no reference invoice found
  IF lv_processed = abap_true.
    CLEAR : lv_count.
* Loop idoc data to get delivery number
    LOOP AT didoc_data ASSIGNING FIELD-SYMBOL(<lfs_idoc>) WHERE segnam = lc_item_seg.
      IF <lfs_idoc> IS ASSIGNED.
        ASSIGN didoc_data[ segnam = lc_zarm_seg psgnum = <lfs_idoc>-segnum ] TO FIELD-SYMBOL(<lfs_idoc_arm>).
        IF sy-subrc = 0 AND <lfs_idoc_arm> IS ASSIGNED.
          lv_count = lv_count + 1.
          ls_arm = <lfs_idoc_arm>-sdata.
* Reading delivery number from ZCOMV_ARM segment
          IF ls_arm-ihrez_e IS NOT INITIAL.
            lv_ihrez = ls_arm-ihrez_e.
          ENDIF.
* Read billing item data for reference invoice number
*select cannot be avoided as we need to fetch data from vbrp that is coming in dynamic loop
          IF lv_ihrez IS NOT INITIAL.
            SELECT vbeln
            UP TO 1 ROWS
            FROM vbrp
            INTO @DATA(lv_vgbel)
            WHERE vgbel     = @lv_ihrez
              AND sfakn_ana = @wc_space
          ORDER BY PRIMARY KEY.
            ENDSELECT.
          ENDIF.

* If reference invoice document found updating kunnr into bdcdata
          IF lv_vgbel IS NOT INITIAL.
            IF lv_count EQ 1.
              IF NOT line_exists( dxbdcdata[ fnam = lc_fnam_vbeln ] ).
                IF line_exists( dxbdcdata[ fnam = lc_fnam_spart ] ).
                  PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_ok lc_fval_rfak.
                  PERFORM enter_references TABLES dxvbap
                                           USING lv_vgbel
                                                 lv_ihrez
                                                 lv_count

                                                 dlast_dynpro
                                                 .
                ENDIF.
              ENDIF.
            ELSEIF lv_count GT 1.
              IF line_exists( dxbdcdata[ fnam = lc_fnam_kuagv ] ).
                READ TABLE lt_vbap ASSIGNING FIELD-SYMBOL(<lfs_vbap1>) INDEX lv_count.
                IF sy-subrc = 0 AND <lfs_vbap1> IS ASSIGNED.
                  IF <lfs_vbap1>-vgbel IS INITIAL.
                    PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_ok lc_fval_copy.
                    PERFORM enter_references TABLES dxvbap
                                             USING lv_vgbel
                                                   lv_ihrez
                                                   lv_count
                                                   dlast_dynpro.

                    PERFORM dynpro_new IN PROGRAM saplveda  USING lc_progname lc_dynpronr CHANGING dlast_dynpro.
                  ENDIF.
                ENDIF.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDIF.
* Check if line exist in bdcdata
  CLEAR lv_processed.
  IF line_exists( dxbdcdata[ fnam = lc_fnam_vbeln  ] ).
    DELETE dxbdcdata WHERE fnam CS lc_fnam_matnr.
    LOOP AT dxbdcdata ASSIGNING FIELD-SYMBOL(<lfs_uer2_del>) WHERE fval = lc_fval_rueb.
      IF <lfs_uer2_del> IS ASSIGNED.
* Deleting uer2 fcode which comes immediately after fcode rueb(create with reference)
        lv_index = sy-tabix + 1.
        ASSIGN dxbdcdata[ lv_index ] TO FIELD-SYMBOL(<lfs_uer2>).
        IF <lfs_uer2> IS ASSIGNED AND  <lfs_uer2>-fval = lc_fval_uer2.
          CLEAR <lfs_uer2>.
        ENDIF.
      ENDIF.
    ENDLOOP.

    IF line_exists( dxbdcdata[ fval = lc_fval_poan ] ).
      ASSIGN dxbdcdata[ fval = lc_fval_poan ] TO FIELD-SYMBOL(<lfs_poan>).
      IF sy-subrc = 0 AND <lfs_poan> IS ASSIGNED.
        ls_bdc_poan = <lfs_poan>.
        DELETE TABLE dxbdcdata FROM ls_bdc_poan.
      ENDIF.
    ENDIF.

  ENDIF.
* checking if charg exists adding plant and storage location to bdc data
  IF  line_exists( dxbdcdata[ fnam = lc_fnam_charg  ] ).
    READ TABLE dxbdcdata INTO DATA(ls_dxbdcdata) INDEX sy-tfill.
    IF ls_dxbdcdata-fval IN lr_charg.
      ASSIGN lr_charg[ low = ls_dxbdcdata-fval ] TO FIELD-SYMBOL(<ls_range>).
      lv_tabix = sy-tabix.
      CONCATENATE lc_selection lv_tabix lc_bracket INTO DATA(lv_fval).
      CONDENSE lv_fval NO-GAPS.
      PERFORM dynpro_new    IN PROGRAM saplveda USING lc_progname lc_dynpronr CHANGING dlast_dynpro.
      PERFORM dynpro_setzen IN PROGRAM saplveda USING lv_fval ls_val.
      PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_ok lc_fval_pkau.
      PERFORM dynpro_new    IN PROGRAM saplveda USING lc_progname lc_dynpronr1 CHANGING dlast_dynpro.
      PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_ok lc_fval_pde2.
      PERFORM dynpro_new    IN PROGRAM saplveda USING lc_progname lc_dynpronr1 CHANGING dlast_dynpro.
      ASSIGN didoc_data[ segnam =  lc_item_seg ] TO FIELD-SYMBOL(<lfs_eledp01>).
      IF <lfs_eledp01> IS ASSIGNED.
        ls_e1edp01_lgort = <lfs_eledp01>-sdata.
        IF ls_e1edp01_lgort-lgort IS NOT INITIAL.
          PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_lgort ls_e1edp01_lgort-lgort. "storage location
          PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_werks ls_e1edp01_lgort-werks. "plant
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.


  IF NOT line_exists( dxbdcdata[ fval = lc_fval_ret ] ).
**    Adding Returns fields just before Save as these should copy in returns Tab
**     after all items got filled
    ASSIGN dxbdcdata[ fval = lc_fval_sich ] TO FIELD-SYMBOL(<lfs_bdcdata1>).
    IF sy-subrc = 0 AND <lfs_bdcdata1> IS ASSIGNED.
      ls_bdc_sich = <lfs_bdcdata1>.
      DELETE TABLE dxbdcdata FROM ls_bdc_sich.
      PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_ok lc_fval_uer2.
      PERFORM dynpro_new    IN PROGRAM saplveda USING lc_progname lc_dynpronr CHANGING dlast_dynpro.
** Add FCODE for Returns Tab as T\03
      PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_ok lc_fval_ret.
      PERFORM dynpro_new    IN PROGRAM saplveda USING lc_progname lc_dynpronr CHANGING dlast_dynpro.
**  ITP1 for going to very first line item in Returns Tab
      PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_ok lc_fval_first.
      LOOP AT didoc_data ASSIGNING FIELD-SYMBOL(<lfs_idoc_data>) WHERE segnam = lc_zarm_seg.
        IF <lfs_idoc_data> IS ASSIGNED.
          ls_arm = <lfs_idoc_data>-sdata.
**  Add Main Dynpro details
          PERFORM dynpro_new    IN PROGRAM saplveda USING lc_progname lc_dynpronr CHANGING dlast_dynpro.
**    ITPP for next item
          PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_ok lc_fval_next.
          ASSIGN didoc_data[ segnam = lc_item_seg segnum = <lfs_idoc_data>-psgnum ] TO FIELD-SYMBOL(<lfs_idoc_item>).
          IF <lfs_idoc_item> IS ASSIGNED.
            ls_idoc_item = <lfs_idoc_item>-sdata.
            PERFORM dynpro_setzen   IN PROGRAM saplveda USING lc_fnam_quan ls_idoc_item-menge.
            IF ls_idoc_item-menee IS NOT INITIAL.
              PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_uom ls_idoc_item-menee.
            ENDIF.
          ENDIF.

**  Add Return Reason code
          IF ls_arm-msr_ret_reason IS NOT INITIAL.
            PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_reas ls_arm-msr_ret_reason.
          ENDIF.
**  Add FU code
          IF ls_arm-fu_code IS NOT INITIAL.
            PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_fucode ls_arm-fu_code.
          ENDIF.
**  Add Return Control
          IF ls_arm-refund_control IS NOT INITIAL.
            PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_ctrl ls_arm-refund_control.
          ENDIF.
**  Add Refund Code
          IF ls_arm-msr_refund_code IS NOT INITIAL.
            PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_code ls_arm-msr_refund_code.
          ENDIF.
**  Add CMR Rejection Reason
          IF ls_arm-abgru IS NOT INITIAL.
            PERFORM dynpro_setzen IN PROGRAM saplveda USING lc_fnam_abgru ls_arm-abgru.
          ENDIF.
        ENDIF.
      ENDLOOP.
      APPEND ls_bdc_sich TO dxbdcdata.
      CLEAR ls_bdc_sich.
    ENDIF.
  ENDIF.

#FM-2
FUNCTION zcomv_dhl_update_customer.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(CNTRL) TYPE  EDIDC
*"     REFERENCE(DVTCOMAG)
*"  TABLES
*"      DXBDCDATA STRUCTURE  BDCDATA
*"      DXVBAP
*"      DXVBEP
*"      DYVBEP
*"      DXVBADR
*"      DYVBADR
*"      DXVBPA STRUCTURE  VBPAVB
*"      DXVBUV
*"      DD_FLAG_P
*"      DXKOMV
*"      DXVEKP
*"      DYVEKP
*"  CHANGING
*"     REFERENCE(DXVBAK)
*"     REFERENCE(DD_FLAG_K)
*"----------------------------------------------------------------------
*&---------------------------------------------------------------------*
*& Development ID:  ZDDE-00086243                                      *
*& Functional Spec: ZFSE-00084652                                      *
*&---------------------------------------------------------------------*
*& Title : Return Order create from DHL>S4                             *
*& This FM triggers from include ZEXIT_VEDU09_01                       *                                                                                                                      *
*& Updates Customer(KUNNR) based on delivery number in IDOC            *
*& Include: ZCOMV_DHL_MESSAGE_UPDATE                                   *
*& INCLUDE:   ZEXIT_VEDU09_01                                          *
*& EXIT Function module: EXIT_SAPLVEDA_007                             *
*&---------------------------------------------------------------------*
*& Change Log:                                                         *
*&---------------------------------------------------------------------*
*& Init     |  Name     |     Date   |            Text                 *
*&---------------------------------------------------------------------*
*& AMIREHA1 A.HARSHITHA  10-Oct-2024 CR: 1100249576  Initial version   *
*&---------------------------------------------------------------------*

  DATA: ls_arm    TYPE zcomv_arm,
        lw_dxvbak TYPE vbak.

  CONSTANTS: lc_arm  TYPE edi_segnam  VALUE 'ZCOMV_ARM'.

* Selecting idoc data usign idoc number
  SELECT docnum,
         counter,
         segnum,
         segnam,
         psgnum,
         hlevel,
         _dataaging,
         dtint2,
         sdata
    FROM edid4
    INTO TABLE @DATA(lt_edid4)
    WHERE docnum = @cntrl-docnum
      AND segnam = @lc_arm
    ORDER BY PRIMARY KEY.
  IF sy-subrc EQ 0.
    ASSIGN lt_edid4[ segnam = lc_arm ] TO FIELD-SYMBOL(<ls_edid4>).
    IF <ls_edid4> IS ASSIGNED.
      ls_arm = <ls_edid4>-sdata.
      DATA(lv_vgbel) = ls_arm-ihrez_e.
    ENDIF.
  ENDIF.
* Select VBRP for invoice doc number
  IF lv_vgbel IS NOT INITIAL.
    SELECT SINGLE vbeln
      FROM vbrp
      INTO @DATA(ls_vbeln)
      WHERE vgbel = @lv_vgbel.
    IF sy-subrc EQ 0.
      DATA(lv_vbeln) = ls_vbeln.
    ELSE.
      MESSAGE e003(zfse_00086242).
    ENDIF.
* Select Sold-to Party of invoice to udpate customer in sale order.
    IF lv_vbeln IS NOT INITIAL.
      SELECT SINGLE kunag
        FROM vbrk
        INTO @DATA(ls_kunag)
        WHERE vbeln = @lv_vbeln.
      IF sy-subrc EQ 0.
        IF ls_kunag IS NOT INITIAL.
          lw_dxvbak = CORRESPONDING #( dxvbak ).
          lw_dxvbak-kunnr = ls_kunag.
          dxvbak = CORRESPONDING #( lw_dxvbak ).
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

ENDFUNCTION.

#FM-3
  FUNCTION zcomv_upd_stor_loc .
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(I_IDOC_NO) TYPE  EDI_DOCNUM OPTIONAL
*"  TABLES
*"      T_VBAP STRUCTURE  VBAPVB
*"      IDOC_STATUS STRUCTURE  BDIDOCSTAT
*"----------------------------------------------------------------------
*&---------------------------------------------------------------------*
*& Development ID:  ZDDE-00086243                                      *
*& Functional Spec: ZFSE-00084652                                      *
*&---------------------------------------------------------------------*
*& Title : Return Order create from DHL>S4                             *
*& This FM triggers from  from  ZCOMV_UPDATE_STOR_LOC                  *                                                                 *
*& USEREXIT_SAVE_DOCUMENT_PREPARE in standard program MV45AFZZ.This    *
*& updateS storage loaction,Batch and plant from IDOC segment to SO    *
*& Include: ZCOMV_DHL_MESSAGE_UPDATE                                   *
*&---------------------------------------------------------------------*
*& Change Log:                                                         *
*&---------------------------------------------------------------------*
*& Init     |  Name     |     Date   |            Text                 *
*&---------------------------------------------------------------------*
*& AMIREHA1 A.HARSHITHA  27-Sep-2024 CR: 1100249576  Initial version   *
*&---------------------------------------------------------------------*

  CONSTANTS: lc_e1edp01 TYPE edi_segnam VALUE 'E1EDP01',
             lc_e1edp19 TYPE edi_segnam VALUE 'E1EDP19',
             lc_i       TYPE char1      VALUE 'I',
             lc_eq      TYPE char2      VALUE 'EQ',
             lc_qualf   TYPE char3      VALUE '010'.

  DATA: ls_e1edp01 TYPE e1edp01,
        ls_e1edp19 TYPE e1edp19,
        lr_segnam  TYPE RANGE OF edi_segnam,
        lv_indx    TYPE sy-tabix,
        lv_count   TYPE i,
        lv_indx1   TYPE sy-tabix VALUE 1.

  lr_segnam = VALUE #( BASE lr_segnam ( sign = lc_i
                                         option = lc_eq
                                         low = lc_e1edp01  ) ).
  lr_segnam = VALUE #( BASE lr_segnam ( sign = lc_i
                                        option = lc_eq
                                        low = lc_e1edp19  ) ).

* Select EDID4 table for idoc data
  SELECT docnum,
         counter,
         segnum,
         segnam,
         psgnum,
         hlevel,
         _dataaging,
         dtint2,
         sdata
    FROM edid4
    INTO TABLE @DATA(lt_edid4)
    WHERE docnum = @i_idoc_no
      AND segnam IN  @lr_segnam
    ORDER BY PRIMARY KEY.
  IF sy-subrc EQ 0.
    DATA(lt_edid4_bt) = lt_edid4[].
* Updating storage location and plant from idoc data
    CLEAR: lv_indx, lv_count.
    LOOP AT lt_edid4 ASSIGNING FIELD-SYMBOL(<ls_edid4>) WHERE segnam = lc_e1edp01.
      lv_count = lv_count + 1.
      ls_e1edp01 = <ls_edid4>-sdata.
      ASSIGN t_vbap[  lv_count ] TO FIELD-SYMBOL(<lfs_vbap>).
      IF <lfs_vbap> IS ASSIGNED.
        LOOP AT lt_edid4_bt ASSIGNING FIELD-SYMBOL(<lfs_edid>) WHERE segnam = lc_e1edp19.
          ls_e1edp19 = <lfs_edid>-sdata.
          IF ls_e1edp19-qualf = lc_qualf.
            DATA(lv_charg) = ls_e1edp19-idtnr.
            CLEAR:lv_indx.
            lv_indx = sy-tabix.
            EXIT.
          ENDIF.
        ENDLOOP.
        <lfs_vbap>-lgort = ls_e1edp01-lgort. "Update storage location
        <lfs_vbap>-werks = ls_e1edp01-werks. "Update Plant
        <lfs_vbap>-charg = lv_charg.         "Update Batch
        IF lt_edid4_bt IS NOT INITIAL.
          DELETE lt_edid4_bt FROM lv_indx1 TO lv_indx.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDIF.

ENDFUNCTION.

#FM-4
FUNCTION zcomv_message_update.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(I_IDOC_NO) TYPE  EDI_DOCNUM
*"  TABLES
*"      IDOC_STATUS STRUCTURE  BDIDOCSTAT
*"----------------------------------------------------------------------
*&---------------------------------------------------------------------*
*& Development ID:  ZDDE-00086243                                      *
*& Functional Spec: ZFSE-00084652                                      *
*&---------------------------------------------------------------------*
*& Title : Return Order create from DHL>S4                             *
*& This FM triggers from  from  ZCOMV_DHL_MESSAGE_UPDATE               *                                                                 *
*& USEREXIT_SAVE_DOCUMENT_PREPARE in standard program MV45AFZZ.This    *
*& updates error message performing checks on batch and charg          *
*& Include: ZCOMV_DHL_MESSAGE_UPDATE                                   *
*& Enhancement Implementation: ZCOMV_DHL_SAVE                          *
*&---------------------------------------------------------------------*
*& Change Log:                                                         *
*&---------------------------------------------------------------------*
*& Init     |  Name     |     Date   |            Text                 *
*&---------------------------------------------------------------------*
*& AMIREHA1 A.HARSHITHA  10-Oct-2024 CR: 1100249576  Initial version   *
*&---------------------------------------------------------------------*

  CONSTANTS: lc_e1edp01 TYPE edi_segnam VALUE 'E1EDP01',
             lc_i       TYPE char1      VALUE 'I',
             lc_eq      TYPE char2      VALUE 'EQ',
             lc_arm     TYPE edi_segnam VALUE 'ZCOMV_ARM',
             lc_e1edp19 TYPE e1edp19    VALUE 'E1EDP19'.

  DATA: ls_arm           TYPE zcomv_arm,
        ls_e1edp01       TYPE e1edp01,
        lr_segnam        TYPE RANGE OF edi_segnam,
        ls_e1edp19_charg TYPE e1edp19,
        ls_e1edp19_matnr TYPE e1edp19,
        matnr_ext        TYPE matnr,
        matnr_int        TYPE matnr,
        lv_matnr         TYPE matnr,
        lv_matnr_1       TYPE matnr,
        lv_posnr         TYPE posnr_vf.

  DATA:indx1 TYPE sy-tabix VALUE 1,
       indx2 TYPE sy-tabix VALUE 4.

  lr_segnam = VALUE #( BASE lr_segnam ( sign = lc_i
                                         option = lc_eq
                                         low = lc_e1edp01  ) ).
  lr_segnam = VALUE #( BASE lr_segnam ( sign = lc_i
                                        option = lc_eq
                                        low = lc_arm  ) ).
  lr_segnam = VALUE #( BASE lr_segnam ( sign = lc_i
                                        option = lc_eq
                                        low = lc_e1edp19  ) ).
* Selecting Idoc data based on idoc number
  SELECT docnum,
         counter,
         segnum,
         segnam,
         psgnum,
         hlevel,
         _dataaging,
         dtint2,
         sdata
    FROM edid4
    INTO TABLE @DATA(lt_edid4)
    WHERE docnum  = @i_idoc_no
    AND segnam IN @lr_segnam
    ORDER BY PRIMARY KEY.
  IF sy-subrc EQ 0.
    LOOP AT lt_edid4 ASSIGNING FIELD-SYMBOL(<ls_edid4>) WHERE segnam = lc_e1edp01.
      IF sy-subrc = 0.
        ls_e1edp01 = <ls_edid4>-sdata.
      ENDIF.
      ASSIGN lt_edid4[ segnam = lc_arm ] TO FIELD-SYMBOL(<lfs_item>).
      IF <lfs_item> IS ASSIGNED.
        ls_arm = <lfs_item>-sdata.
        IF ls_arm-ihrez_e IS NOT INITIAL.
          DATA(lv_ihrez) = ls_arm-ihrez_e.
        ENDIF.
        IF lv_ihrez IS NOT INITIAL.
          SELECT vbeln, posnr, vgpos, fkimg, charg, matnr
            FROM vbrp
            INTO TABLE @DATA(lt_vgbel)
            WHERE vgbel     = @lv_ihrez
              AND sfakn_ana = @wc_space
          ORDER BY PRIMARY KEY.
        ENDIF.

        CLEAR lv_posnr.
        lv_posnr = ls_e1edp01-posex.
        ASSIGN lt_vgbel[ vgpos = lv_posnr ] TO FIELD-SYMBOL(<ls_vgbel>).
        IF <ls_vgbel> IS ASSIGNED.
          matnr_int = <ls_vgbel>-matnr.
          matnr_ext = |{ matnr_int ALPHA = OUT }|.
          DATA(lv_menge) = ls_e1edp01-menge.
          ASSIGN lt_edid4[ 4 ] TO FIELD-SYMBOL(<lfs_e1edp19>).
          IF <lfs_e1edp19> IS ASSIGNED.
            ls_e1edp19_charg = <lfs_e1edp19>-sdata.
            DATA(lv_idtnr) = ls_e1edp19_charg-idtnr.
          ENDIF.

          ASSIGN lt_edid4[ 3 ] TO FIELD-SYMBOL(<lfs_e1edp19_mat>).
          IF <lfs_e1edp19_mat> IS ASSIGNED.
            ls_e1edp19_matnr = <lfs_e1edp19_mat>-sdata.
            lv_matnr_1 = ls_e1edp19_matnr-idtnr.
            lv_matnr = |{ lv_matnr_1 ALPHA = OUT }|.
          ENDIF.

          IF idoc_status IS INITIAL.
            IF lv_menge GT <ls_vgbel>-fkimg.
* Populate MENGE(quantity) is greater than quantity in refernce invoice
              MESSAGE e000(zfse_00086242).
            ELSEIF lv_idtnr NE <ls_vgbel>-charg.
* Populate IDTNR(batch) is not same as batch in refernce invoice
              MESSAGE e001(zfse_00086242).
            ENDIF.
            IF lv_matnr NE matnr_ext.
* Populate MATNR(material) is not same as material in refernce invoice
              MESSAGE e002(zfse_00086242).
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.

      IF lt_edid4 IS NOT INITIAL.
        DELETE lt_edid4 FROM indx1 TO indx2.
      ENDIF.

    ENDLOOP.
  ENDIF.

ENDFUNCTION.



