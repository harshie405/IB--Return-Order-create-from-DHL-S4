           lc_key_l1 TYPE zexitkey  VALUE 'SNDPRN/VKORG/VTWEG',
           lc_slash1 TYPE char1     VALUE '/',
           lc_key_l2 TYPE zexitkey  VALUE 'SPART/AUART'.

